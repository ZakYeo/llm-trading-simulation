{
  "name": "@llm-sim/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "lint": "eslint src --ext .ts",
    "postinstall": "prisma generate",
    "start": "node dist/main.js",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "bash ./scripts/run-integration-tests.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@llm-sim/mcp-contracts": "workspace:*",
    "@llm-sim/shared-types": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "dotenv": "^17.2.3",
    "openai": "^6.33.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "prisma": "7.7.0",
    "tsx": "^4.20.6"
  }
}
