generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-client-runtime"
}

datasource db {
  provider = "postgresql"
}

enum GameStatus {
  SETUP
  ACTIVE
  SETTLEMENT
  COMPLETED
  FAILED
}

enum AgentRole {
  BANKER
  ANALYST
  LAWYER
  INFLUENCER
  TRADER
}

enum AgentMessageVisibility {
  PUBLIC
  PRIVATE
}

enum AgentTurnActionType {
  SEND_PUBLIC_MESSAGE
  SEND_PRIVATE_MESSAGE
  PROPOSE_DIRECT_TRANSFER
  COUNTER_DIRECT_TRANSFER_PROPOSAL
  ACCEPT_DIRECT_TRANSFER_PROPOSAL
  REJECT_DIRECT_TRANSFER_PROPOSAL
  PLACE_FUNDS_WITH_BANKER
  REDEEM_FUNDS_FROM_BANKER
  FINALIZE_TURN
}

model GameSession {
  id           String       @id @default(uuid())
  name         String
  status       GameStatus    @default(SETUP)
  currentRound Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  agents       Agent[]
  rounds       GameRound[]
  agentMessages AgentMessage[]
  agentTurnActions AgentTurnAction[]
  transfers    Transfer[]
  deposits     Deposit[]
  withdrawals  Withdrawal[]
  bankerCustodyPositions BankerCustodyPosition[]
  custodyPlacements CustodyPlacement[]
  custodyRedemptions CustodyRedemption[]
  custodyAccruals CustodyAccrual[]
}

model Agent {
  id             String             @id @default(uuid())
  gameSessionId String
  name          String
  role          AgentRole
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  gameSession   GameSession        @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  balance       AgentBalance?
  depositAccount AgentDepositAccount?
  sentMessages AgentMessage[] @relation("AgentMessageSender")
  receivedMessages AgentMessage[] @relation("AgentMessageRecipient")
  turnActions  AgentTurnAction[]
  outgoingTransfers Transfer[]     @relation("TransferSourceAgent")
  incomingTransfers Transfer[]     @relation("TransferDestinationAgent")
  deposits      Deposit[]
  withdrawals   Withdrawal[]
  bankerCustodyPositionsAsBanker BankerCustodyPosition[] @relation("BankerCustodyBanker")
  bankerCustodyPositionsAsOwner BankerCustodyPosition[] @relation("BankerCustodyOwner")
  custodyPlacementsAsBanker CustodyPlacement[] @relation("CustodyPlacementBanker")
  custodyPlacementsAsOwner CustodyPlacement[] @relation("CustodyPlacementOwner")
  custodyRedemptionsAsBanker CustodyRedemption[] @relation("CustodyRedemptionBanker")
  custodyRedemptionsAsOwner CustodyRedemption[] @relation("CustodyRedemptionOwner")
  custodyAccrualsAsBanker CustodyAccrual[] @relation("CustodyAccrualBanker")
  custodyAccrualsAsOwner CustodyAccrual[] @relation("CustodyAccrualOwner")
}

model AgentBalance {
  id         String   @id @default(uuid())
  agentId     String   @unique
  available   Decimal  @db.Decimal(18, 4)
  reserved    Decimal  @db.Decimal(18, 4) @default(0)
  updatedAt   DateTime @updatedAt
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model AgentDepositAccount {
  id         String   @id @default(uuid())
  agentId     String   @unique
  principal   Decimal  @db.Decimal(18, 4)
  accrued     Decimal  @db.Decimal(18, 4) @default(0)
  updatedAt   DateTime @updatedAt
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model GameRound {
  id            String      @id @default(uuid())
  gameSessionId String
  roundNumber   Int
  createdAt     DateTime    @default(now())
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
}

model AgentMessage {
  id               String                 @id @default(uuid())
  gameSessionId    String
  roundNumber      Int
  turnNumber       Int                    @default(1)
  senderAgentId    String
  recipientAgentId String?
  visibility       AgentMessageVisibility
  content          String
  createdAt        DateTime               @default(now())
  gameSession      GameSession            @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  senderAgent      Agent                  @relation("AgentMessageSender", fields: [senderAgentId], references: [id], onDelete: Cascade)
  recipientAgent   Agent?                 @relation("AgentMessageRecipient", fields: [recipientAgentId], references: [id], onDelete: SetNull)
}

model AgentTurnAction {
  id               String             @id @default(uuid())
  gameSessionId    String
  roundNumber      Int
  turnNumber       Int
  agentId          String
  recipientAgentId String?
  relatedProposalActionId String?
  actionType       AgentTurnActionType
  amount           Decimal?           @db.Decimal(18, 4)
  content          String?
  createdAt        DateTime           @default(now())
  gameSession      GameSession        @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  agent            Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Transfer {
  id                 String      @id @default(uuid())
  gameSessionId      String
  sourceAgentId      String
  destinationAgentId String
  amount             Decimal     @db.Decimal(18, 4)
  createdAt          DateTime    @default(now())
  gameSession        GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  sourceAgent        Agent       @relation("TransferSourceAgent", fields: [sourceAgentId], references: [id], onDelete: Cascade)
  destinationAgent   Agent       @relation("TransferDestinationAgent", fields: [destinationAgentId], references: [id], onDelete: Cascade)
}

model Deposit {
  id            String      @id @default(uuid())
  gameSessionId String
  agentId       String
  amount        Decimal     @db.Decimal(18, 4)
  createdAt     DateTime    @default(now())
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  agent         Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Withdrawal {
  id            String      @id @default(uuid())
  gameSessionId String
  agentId       String
  amount        Decimal     @db.Decimal(18, 4)
  createdAt     DateTime    @default(now())
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  agent         Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model BankerCustodyPosition {
  id            String   @id @default(uuid())
  gameSessionId String
  bankerAgentId String
  ownerAgentId  String
  principal     Decimal  @db.Decimal(18, 4)
  accrued       Decimal  @db.Decimal(18, 4) @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  bankerAgent   Agent @relation("BankerCustodyBanker", fields: [bankerAgentId], references: [id], onDelete: Cascade)
  ownerAgent    Agent @relation("BankerCustodyOwner", fields: [ownerAgentId], references: [id], onDelete: Cascade)

  @@unique([gameSessionId, bankerAgentId, ownerAgentId])
}

model CustodyPlacement {
  id            String   @id @default(uuid())
  gameSessionId String
  roundNumber   Int
  bankerAgentId String
  ownerAgentId  String
  amount        Decimal  @db.Decimal(18, 4)
  createdAt     DateTime @default(now())
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  bankerAgent   Agent @relation("CustodyPlacementBanker", fields: [bankerAgentId], references: [id], onDelete: Cascade)
  ownerAgent    Agent @relation("CustodyPlacementOwner", fields: [ownerAgentId], references: [id], onDelete: Cascade)
}

model CustodyRedemption {
  id            String   @id @default(uuid())
  gameSessionId String
  roundNumber   Int
  bankerAgentId String
  ownerAgentId  String
  amount        Decimal  @db.Decimal(18, 4)
  createdAt     DateTime @default(now())
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  bankerAgent   Agent @relation("CustodyRedemptionBanker", fields: [bankerAgentId], references: [id], onDelete: Cascade)
  ownerAgent    Agent @relation("CustodyRedemptionOwner", fields: [ownerAgentId], references: [id], onDelete: Cascade)
}

model CustodyAccrual {
  id            String   @id @default(uuid())
  gameSessionId String
  roundNumber   Int
  bankerAgentId String
  ownerAgentId  String
  amount        Decimal  @db.Decimal(18, 4)
  createdAt     DateTime @default(now())
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  bankerAgent   Agent @relation("CustodyAccrualBanker", fields: [bankerAgentId], references: [id], onDelete: Cascade)
  ownerAgent    Agent @relation("CustodyAccrualOwner", fields: [ownerAgentId], references: [id], onDelete: Cascade)
}
